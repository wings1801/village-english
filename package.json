{
  "name": "village-english",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "e2e": "playwright test --pass-with-no-tests",
    "validate-content": "tsx scripts/validate-content.ts",
    "build-review": "tsx scripts/build-review-page.ts",
    "import-words": "tsx scripts/import-wordlists.ts",
    "import-tatoeba": "tsx scripts/import-tatoeba.ts",
    "gen-credits": "tsx scripts/gen-credits.ts",
    "build-word-grades": "tsx scripts/build-word-grades.ts",
    "build-content": "npm run validate-content && tsx scripts/build-content.ts"
  },
  "dependencies": {
    "idb": "8.0.4",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.7",
    "jsdom": "31.0.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
